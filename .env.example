# ---- database -------------------------------------------------------------
# Read-only analytics role. On the Supavisor pooler the username MUST carry the
# project ref after a dot, or auth fails looking like a wrong password.
DATABASE_URI=postgresql://ROLE.PROJECT_REF:PASSWORD@HOST:PORT/postgres?sslmode=require

# ---- deployment (host-specific; the only things to change per VPS) ---------
MCP_CONTAINER_NAME=analytics-mcp
MCP_HOSTNAME=mcp-origin.example.com
TRAEFIK_NETWORK=web
MCP_CONFIG=/app/config/example.yaml
LOG_LEVEL=INFO
